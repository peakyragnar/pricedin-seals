    "thesis": {
      "commitments": [
        {
          "claim": "Increasing earnings potential without significant additional CapEx; Mohawk Valley and Siler City initial phases substantially complete, so gross capital investment is expected to continue to decrease in FY26 and stay modulatable thereafter.",
          "source": "Q3 FY26 earnings presentation p.6; 10-Q MD&A liquidity (0000895419-26-000030:wolf-20260329.htm:b0000576)",
          "horizon": "FY26-FY28",
          "flows_into": [
